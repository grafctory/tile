{
  "name": "@grafctory/tile",
  "version": "0.10.1",
  "description": "Preact linked data store and shape-driven value types for @grafctory/tile.",
  "keywords": [
    "typescript",
    "preact",
    "json-ld",
    "model-driven",
    "ui"
  ],
  "homepage": "https://grafctory.github.io/tile/",
  "bugs": {
    "url": "https://github.com/grafctory/tile/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/tile.git",
    "directory": "packages/tile"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "@grafctory/source": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./types/*": {
      "@grafctory/source": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "./types/*.core": null,
    "./*": {
      "@grafctory/source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "./*.core": null
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules '*.tsbuildinfo'",
    "build": "tsc -b tsconfig.build.json",
    "check": "npx vitest --config ../../vitest.config.ts --root . --typecheck --passWithNoTests --environment happy-dom run"
  },
  "dependencies": {
    "@grafctory/blue": "^0.15.0",
    "@grafctory/core": "^0.14.0",
    "@grafctory/http": "^0.6.0",
    "@grafctory/keep": "^0.14.1",
    "@grafctory/keep-rest": "^0.14.1",
    "@grafctory/qest": "^0.15.0"
  },
  "devDependencies": {
    "@grafctory/clay": "^0.4.0",
    "happy-dom": "^21.0.4",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@grafctory/clay": "^0.4.0",
    "preact": "^10.27.2"
  }
}
